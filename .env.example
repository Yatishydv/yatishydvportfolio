# Environment Variables — DO NOT COMMIT THIS FILE
# Copy this to .env and fill in your values

# The ONE email address allowed to access /admin
ADMIN_EMAIL=yatish0155@gmail.com

# Resend.com API key (get from resend.com — free plan, ~100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Atlas connection string (get from cloud.mongodb.com — free M0 cluster)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Random 64-character hex string for signing session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-64-char-hex-string-here

# The email address that OTPs are sent FROM (can be onboarding@resend.dev on free plan)
EMAIL_FROM=admin@yatishkumar.site
